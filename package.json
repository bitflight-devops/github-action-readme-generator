{
  "name": "github-action-readme-generator",
  "displayName": "bitflight-devops/github-action-readme-generator",
  "version": "1.11.0",
  "description": "The docs generator for GitHub Actions. Auto-syncs action.yml to README.md with 8 sections: inputs, outputs, usage, badges, branding & more. Works as CLI or GitHub Action.",
  "keywords": [
    "github-actions",
    "actions",
    "documentation",
    "readme-generator",
    "action-yml",
    "markdown-generator",
    "github-action-docs",
    "auto-docs",
    "devops",
    "cli",
    "inputs-outputs",
    "usage-generator"
  ],
  "homepage": "https://github.com/bitflight-devops/github-action-readme-generator#readme",
  "bugs": {
    "url": "https://github.com/bitflight-devops/github-action-readme-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitflight-devops/github-action-readme-generator.git"
  },
  "license": "Apache-2.0",
  "author": "Jamie Nelson <jamie@bitflight.io>",
  "type": "module",
  "exports": {
    "types": "./dist/mjs/index.d.ts",
    "import": "./dist/mjs/index.js"
  },
  "module": "dist/mjs/index.js",
  "types": "dist/mjs/index.d.ts",
  "bin": {
    "github-action-readme-generator": "dist/bin/index.js"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "action.yml",
    "dist/"
  ],
  "scripts": {
    "all": "npm run build && npm run format && npm run lint && npm run test",
    "prebuild": "tsc --project tsconfig.json --noemit",
    "build": "rimraf dist out && vp pack && chmod +x dist/bin/index.js",
    "build:docker": "run-script-os",
    "build:docker:default": "docker run --rm -t -v $(pwd):/work -w /work node:24-alpine sh -c 'apk add --no-cache curl && curl -fsSL https://viteplus.dev/install.sh | VP_NODE_MANAGER=no bash && export PATH=\"$HOME/.vite-plus/bin:$PATH\" && npm run build'",
    "build:docker:win32": "docker run --rm -t -v \"%cd%\":/work -w /work node:24-alpine sh -c \"apk add --no-cache curl && curl -fsSL https://viteplus.dev/install.sh | VP_NODE_MANAGER=no bash && export PATH=\\\"$HOME/.vite-plus/bin:$PATH\\\" && npm run build\"",
    "clean": "rimraf dist",
    "commit": "git-cz",
    "corepack": "corepack enable",
    "current-version": "jq -r '.version' package.json",
    "format": "vp fmt --write ./src ./__tests__",
    "format:check": "vp fmt --check ./src ./__tests__",
    "generate-docs": "echo 'Generating docs' && node dist/bin/index.js && (git add README.md ./.github/ghadocs .ghadocs.json || true)",
    "postinstall": "echo '✨ Successfully Installed'",
    "lint": "vp lint --type-aware --type-check ./src/ ./__tests__/ && npm run lint:markdown",
    "lint:fix": "vp lint --type-aware --type-check --fix ./src/ ./__tests__/ && npm run lint:markdown:fix",
    "check": "vp check ./src/ ./__tests__/",
    "check:fix": "vp check --fix ./src/ ./__tests__/",
    "markdownlint": "markdownlint",
    "lint:markdown": "markdownlint \"**/*.md\" --config=.markdownlint.json --ignore-path=.markdownlintignore",
    "lint:markdown:fix": "npm run lint:markdown -- --fix",
    "pre-commit": "vp staged && npm run build && npm run generate-docs && npm run lint:markdown",
    "prepare": "[ -n \"${GITHUB_ACTIONS:-}\" ] || { husky install; command -v vp >/dev/null 2>&1 || curl -fsSL https://viteplus.dev/install.sh | VP_NODE_MANAGER=no bash; }",
    "semantic-release": "semantic-release",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "version:manual": "echo 'Run versioning commands';echo \"::set-output name=tag::v${npm_package_version}\"",
    "postversion:manual": "git push --tags origin && git push origin"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-length": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "footer-max-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ],
      "header-max-length": [
        0
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "branches": [
      "main",
      "next",
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "npm run generate-docs"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": true,
          "provenance": true
        }
      ],
      "@semantic-release/github",
      "@semantic-release/git"
    ],
    "preset": "angular"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@svgdotjs/svg.js": "^3.2.5",
    "@types/feather-icons": "^4.29.4",
    "@types/svgdom": "^0.1.2",
    "chalk": "^5.6.2",
    "feather-icons": "^4.29.2",
    "nconf": "^0.13.0",
    "prettier": "^3.8.1",
    "svgdom": "^0.1.22",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/prompt": "^21.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tsconfig/node20": "^20.1.2",
    "@types/nconf": "^0.10.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@voidzero-dev/vite-plus-core": "0.2.8",
    "commitizen": "^4.3.1",
    "conventional-commits": "^1.6.0",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.2.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "markdownlint-cli": "^0.49.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "^6.1.2",
    "run-script-os": "^1.1.6",
    "semantic-release": "^25.0.2",
    "types-package-json": "^2.0.39",
    "typescript": "7.0.2",
    "vite-plus": "0.2.8"
  },
  "engines": {
    "node": ">=24.19.0 <30.0.0",
    "npm": ">=10.0.0"
  },
  "os": [
    "!win32"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "volta": {
    "node": "24.19.0"
  }
}
